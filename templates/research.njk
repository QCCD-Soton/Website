---
layout: base.njk
---
<h1>{{ title }}</h1>
<div class="prose">{{ content | safe }}</div>
{% for theme in collections.research %}
<section class="theme" id="{{ theme.fileSlug }}">
  <h2>{{ theme.data.title }}</h2>
  {% if theme.data.image %}<img src="{{ theme.data.image | img }}" alt="{{ theme.data.image_alt }}">{% endif %}
  <div class="prose">{{ theme.content | safe }}</div>
</section>
{% endfor %}
