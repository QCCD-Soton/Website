---
layout: base.njk
---
{#- News timeline and publications: the latest few of each, the rest behind a button. -#}
{%- set shown = 4 %}
{%- set shown_pubs = 6 %}
<section class="block" aria-labelledby="news-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 id="news-title">{{ heading or title }}</h2>
        {% if content | trim %}<div class="lede prose">{{ content | safe }}</div>{% endif %}
      </div>
    </div>
    <div class="sec-body">
      <ol class="timeline" id="timeline">
        {% for post in collections.news %}{% set more = loop.index > shown %}{% include "news-item.njk" %}{% endfor %}
      </ol>
      {% if collections.news.length > shown %}
      <button class="tl-toggle" id="tlToggle" aria-expanded="false" aria-controls="timeline">Show older news ({{ collections.news.length - shown }})</button>
      {% endif %}
    </div>
  </div>
</section>

<section class="block" id="publications" aria-labelledby="pubs-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 id="pubs-title">Publications</h2>
        <p class="lede">{{ publications_intro }}</p>
      </div>
    </div>
    <div class="sec-body">
      {% if publications.length %}
      <div class="pub-tools" role="group" aria-label="Filter by year">
        <button class="chip" data-year="all" aria-pressed="true">All</button>
        {% for year, pubs in publications | groupByYear %}<button class="chip" data-year="{{ year }}" aria-pressed="false">{{ year }}</button>{% endfor %}
      </div>
      <ol class="pubs" id="pubs">{% for pub in publications %}{% set more = loop.index > shown_pubs %}{% include "publication.njk" %}{% endfor %}</ol>
      {% if publications.length > shown_pubs %}
      <button class="tl-toggle pub-toggle" id="pubToggle" aria-expanded="false" aria-controls="pubs">Show all {{ publications.length }} publications</button>
      {% endif %}
      {% else %}
      <p class="pub-foot">No publications fetched yet. They appear here once the weekly update has run.</p>
      {% endif %}
    </div>
  </div>
</section>
