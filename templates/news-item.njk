{#- An item links to its own page only if it has one (see content/news/news.11tydata.js). -#}
{%- set text = post.data.summary or (post.rawInput | firstSentence) %}
<li class="tl{% if more %} tl-more{% endif %}">
  <time datetime="{{ post.date.toISOString() }}">{{ post.date | date }}</time><span class="dot" aria-hidden="true"></span>
  <div class="tl-body">
    {% if post.data.kind %}<span class="tl-kind">{{ post.data.kind }}</span>{% endif %}
    <h3>{% if post.url %}<a href="{{ post.url }}">{{ post.data.title }}</a>{% else %}{{ post.data.title }}{% endif %}</h3>
    {% if text | trim %}<p>{{ text }}</p>{% endif %}
  </div>
</li>
