<li class="pub">
  <a class="pub-title" href="{{ pub.url }}">{{ pub.title }}</a>
  <span class="authors">{{ pub.authors | join(", ") }}</span>
  <span class="venue">{{ pub.venue }}{% if pub.year %} ({{ pub.year }}){% endif %}</span>
  {% if pub.preprint %}<span class="badge">Preprint</span>{% endif %}
  {% if pub.open_access_url %}<a class="badge" href="{{ pub.open_access_url }}">Open access</a>{% endif %}
</li>
