---
layout: base.njk
---
{#- Quantum themes hang off a qubit wire, one gate per theme taken from this list in order, with the measurement always on the last theme.
    Each gate has its own colour (--sig-<id> in style.css) and its own effect on the qubit (.wired[data-gate="<id>"] in style.css),
    so the list can grow or be reordered freely. Classical themes get a particle-in-a-box scroll bar. -#}
{%- set themes = collections.research | track(track) %}
{%- set gates = ["h", "z", "rx", "s", "ry", "t"] %}
{%- set prefix = "rq-" if track == "quantum" else "rc-" %}
<section class="block" id="research-{{ track }}" aria-labelledby="track-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 id="track-title">{{ heading or title }}</h2>
        <div class="lede prose">{{ content | safe }}</div>
      </div>
    </div>
    <div class="sec-body">
      <nav class="theme-index" aria-label="Major themes">
        <span class="eyebrow">Major themes</span>
        <ol>{% for theme in themes %}<li><a href="#{{ prefix }}{{ theme.fileSlug }}"><span class="n">{{ loop.index | pad }}</span>{{ theme.data.title }}</a></li>{% endfor %}</ol>
      </nav>
    </div>

    {% if track == "quantum" %}
    <div class="sec-body themes wired" id="qwire">
      <div class="rail" aria-hidden="true"><div class="clip"><div class="fill"></div><div class="cover"></div></div><div class="photon"><div class="spin"><i class="q a"></i><i class="q b"></i></div></div></div>
      {% for theme in themes %}
      {%- set gate = "m" if loop.last else gates[loop.index0 % gates.length] %}
      <article class="theme" id="{{ prefix }}{{ theme.fileSlug }}" data-gate="{{ gate }}" style="--sig: var(--sig-{{ gate }})">
        <div class="tgate" aria-hidden="true">
          {%- if gate == "m" %}<svg viewBox="0 0 44 44"><path d="M8 32 A14 14 0 0 1 36 32" fill="none" stroke="currentColor" stroke-width="2"></path><line x1="22" y1="32" x2="33" y2="13" stroke="currentColor" stroke-width="2"></line></svg>
          {%- elif gate == "rx" or gate == "ry" %}<span>R<sub>{{ gate[1] }}</sub></span>
          {%- else %}{{ gate | upper }}{% endif -%}
        </div>
        {% include "theme.njk" %}
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="cgrid">
      <aside class="cside" id="cbox" aria-label="Page position">
        <div class="cbox">
          <span class="eyebrow">Particle in a box</span>
          <div class="cbox-body">
            <canvas aria-hidden="true"></canvas>
            <ol class="cbox-list">
              {% for theme in themes %}<li><a href="#{{ prefix }}{{ theme.fileSlug }}"><span class="n">{{ loop.index | pad }}</span>{{ theme.data.short_title or theme.data.title }}</a></li>{% endfor %}
            </ol>
          </div>
          <span class="cbox-n">n = 1</span>
        </div>
      </aside>
      <div class="sec-body themes" id="cwire">
        {% for theme in themes %}
        <article class="theme" id="{{ prefix }}{{ theme.fileSlug }}">
          {% include "theme.njk" %}
        </article>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>
