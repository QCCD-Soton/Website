---
layout: base.njk
---
<section class="hero">
  <h1>{{ site.tagline }}</h1>
  <div class="prose">{{ content | safe }}</div>
  {% if group_photo %}<img class="group-photo" src="{{ group_photo | img }}" alt="The QCCD group">{% endif %}
</section>

<section>
  <h2>Research</h2>
  <div class="cards">
    {% for theme in collections.research %}
    <a class="card" href="/research/#{{ theme.fileSlug }}">
      <h3>{{ theme.data.title }}</h3>
      <p>{{ theme.rawInput | firstSentence }}</p>
    </a>
    {% endfor %}
  </div>
</section>

<section>
  <h2>Latest news</h2>
  {% for post in collections.news | head(3) %}{% include "news-item.njk" %}{% endfor %}
  <p><a href="/news/">All news</a></p>
</section>

{% if publications.length %}
<section>
  <h2>Recent publications</h2>
  <ol class="pubs">{% for pub in publications | head(3) %}{% include "publication.njk" %}{% endfor %}</ol>
  <p><a href="/publications/">All publications</a></p>
</section>
{% endif %}
