---
layout: base.njk
---
{%- set title_parts = site.title.split(" & ") %}
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-copy">
      <span class="eyebrow">{{ site.university }} · {{ site.school }}</span>
      <h1 id="hero-title">{% if title_parts.length == 2 %}{{ title_parts[0] }} &amp; <em>{{ title_parts[1] }}</em>{% else %}{{ site.title }}{% endif %}</h1>
    </div>
    <figure class="orbital" style="margin:0">
      <canvas id="orbital" data-electrons="2" data-axis="none" role="img" aria-label="Group logo: electrons orbiting a Bloch sphere, with four qubits running in and out to four measurements"></canvas>
    </figure>
  </div>
  <div class="wrap">
    <figure class="group-photo">
      {% if group_photo %}
      <img class="photo" src="{{ group_photo | img }}" alt="{{ group_photo_alt or 'The group' }}">
      {% else %}
      <div class="photo-ph" role="img" aria-label="Group photo placeholder">
        <span class="photo-tag">Group photo</span>
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="14" rx="2" stroke="currentColor" stroke-width="1.2"></rect><circle cx="12" cy="12.5" r="3.6" stroke="currentColor" stroke-width="1.2"></circle><path d="M8 5.5l1.4-2h5.2l1.4 2" stroke="currentColor" stroke-width="1.2"></path></svg>
      </div>
      {% endif %}
      {% if group_photo_caption %}<figcaption>{{ group_photo_caption }}</figcaption>{% endif %}
    </figure>
    <div class="lede home-intro prose">{{ content | safe }}</div>
  </div>
  {% if site.logos.length %}
  <div class="wrap">
    <div class="funders" aria-labelledby="funders-title">
      <span class="eyebrow" id="funders-title">Funded by and working with</span>
      <ul class="funder-row">
        {% for l in site.logos %}<li><a href="{{ l.url }}"><img src="{{ l.logo | img }}" alt="{{ l.name }}"></a></li>{% endfor %}
      </ul>
    </div>
  </div>
  {% else %}
  <div class="funders"></div>
  {% endif %}
</section>
