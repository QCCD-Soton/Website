<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- The tab, bookmark and search-result title. Names the group and university so searches for them find the site. #}
  {%- set pageTitle %}{% if title and title != "Home" %}{{ title }}{% else %}{{ site.title }}{% endif %} · {{ site.subtitle }}, {{ site.university }}{% endset %}
  {%- set description = { description: description, summary: summary } | describe(page.rawInput, site.tagline) %}
  {%- set shareImage = image or site.share_image %}
  <title>{{ pageTitle | safe }}</title>
  <meta name="description" content="{{ description }}">
  {%- if site.url and page.url %}
  <link rel="canonical" href="{{ page.url | htmlBaseUrl(site.url) }}">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title if title and title != 'Home' else site.title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | htmlBaseUrl(site.url) }}">
  <meta property="og:locale" content="en_GB">
  {%- if shareImage %}
  <meta property="og:image" content="{{ shareImage | img | htmlBaseUrl(site.url) }}">
  <meta property="og:image:alt" content="{{ (image_alt if image else site.share_image_alt) or site.title }}">
  {%- endif %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if shareImage else 'summary' }}">
  {%- endif %}
  <script>try { var t = localStorage.getItem('qccd-theme'); if (t) document.documentElement.setAttribute('data-theme', t); if (localStorage.getItem('qccd-pink')) document.documentElement.setAttribute('data-pink', ''); if (localStorage.getItem('qccd-wide')) document.documentElement.setAttribute('data-wide', ''); } catch (e) {}</script>
  <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/pink.css">
  <link rel="stylesheet" href="/wide.css">
  {%- if 'class="katex' in content %}
  <link rel="stylesheet" href="/katex/katex.min.css">
  {%- endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/images/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{%- set section = page.url.split("/")[1] %}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="{{ site.title }} home">
      <canvas class="brand-mark" id="brand-logo" aria-hidden="true"></canvas>
      <span class="brand-text">
        <span class="brand-name">{{ site.title }}</span>
        <span class="brand-sub">{{ site.subtitle }}</span>
      </span>
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a>
      <div class="nav-drop">
        <a href="/research/" class="drop-trigger" aria-haspopup="true"{% if section == "research" %} aria-current="page"{% endif %}>Research <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.3" fill="none"></path></svg></a>
        <div class="drop-menu" role="menu">
          {%- for track in collections.tracks %}
          <a href="{{ track.url }}" role="menuitem"{% if page.url == track.url %} aria-current="page"{% endif %}><b>{{ track.data.title }}</b><span>{{ track.data.summary }}</span></a>
          {%- endfor %}
        </div>
      </div>
      <a href="/people/"{% if section == "people" %} aria-current="page"{% endif %}>People</a>
      <a href="/news/"{% if section == "news" %} aria-current="page"{% endif %}>News</a>
      <a href="/publications/"{% if section == "publications" %} aria-current="page"{% endif %}>Publications</a>
      <a class="cta" href="/join/"{% if section == "join" %} aria-current="page"{% endif %}>Join us</a>
    </nav>
    <button class="theme-btn menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.4" fill="none"></path></svg>
    </button>
    <button class="theme-btn t" id="themeBtn" aria-label="Toggle light or dark theme">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.3" fill="none"></circle><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor"></path></svg>
    </button>
  </div>
</header>

<main id="main" tabindex="-1">
  {{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <a class="foot-name" href="/">{{ site.title }}</a>
        {% if site.subtitle %}<span class="foot-sub">{{ site.subtitle }}</span>{% endif %}
        <address>{{ site.address | trim | replace("\n", "<br>") | safe }}</address>
      </div>
      <nav class="foot-col" aria-label="Footer">
        <span class="eyebrow">Pages</span>
        {%- for track in collections.tracks %}
        <a href="{{ track.url }}">{{ track.data.title }}</a>
        {%- endfor %}
        <a href="/people/">People</a>
        <a href="/news/">News</a>
        <a href="/publications/">Publications</a>
        <a href="/join/">Join us</a>
      </nav>
      <div class="foot-col" id="contact">
        <span class="eyebrow">Contact</span>
        {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
        {% if site.school_url %}<a href="{{ site.school_url }}">{{ site.school }}</a>{% endif %}
        {% if site.university_url %}<a href="{{ site.university_url }}">{{ site.university }}</a>{% endif %}
      </div>
    </div>
    <div class="legal">
      <span>© {{ "now" | year }} {{ site.title }}, {{ site.university }}</span>
    </div>
  </div>
</footer>
<script src="/site.js"></script>
<script src="/pink.js"></script>
<script src="/wide.js"></script>
</body>
</html>
