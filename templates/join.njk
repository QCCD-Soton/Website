---
layout: base.njk
---
<section class="block join" aria-labelledby="join-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h1 id="join-title">{{ heading or title }}</h1>
        <div class="lede prose">{{ content | safe }}</div>
      </div>
    </div>
    <div class="sec-body">
      {% if roles.length %}
      <div class="roles">
        {% for r in roles %}
        <div class="role-card"><span class="k">{{ r.level }}</span><h3>{{ r.title }}</h3>
          <p>{{ r.text | inlineMd | safe }}</p>{% if r.status %}<span class="status">{{ r.status }}</span>{% endif %}</div>
        {% endfor %}
      </div>
      {% endif %}
      {% if site.email %}
      <div class="join-actions">
        <a class="btn primary" href="mailto:{{ site.email }}">Make an enquiry</a>
        {% if enquiries %}<span>{{ enquiries }}</span>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
