{#- One research theme: name, one-line summary, figure, then the full text. Expects `theme` and `loop`. -#}
<header class="theme-head">
  <h3>{{ theme.data.title }}</h3>
  {% if theme.data.summary %}<p class="theme-short">{{ theme.data.summary }}</p>{% endif %}
</header>
<figure class="theme-fig">
  {% if theme.data.image %}
  <img class="fig" src="{{ theme.data.image | img }}" alt="{{ theme.data.image_alt }}">
  {% else %}
  <div class="fig-ph" role="img" aria-label="Image placeholder for {{ theme.data.title }}">
    {%- set art = loop.index0 % 4 %}
    <svg class="fig-art" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      {%- if art == 0 %}<path d="M28 6l19 11v22L28 50 9 39V17z"></path><path d="M28 16l10 6v12l-10 6-10-6V22z" opacity=".5"></path><circle cx="28" cy="28" r="2" fill="currentColor"></circle>
      {%- elif art == 1 %}<path d="M6 40c6-20 10-20 14-6s8 14 12-6 8-20 12 0 6 12 6 12"></path><path d="M6 30h44" opacity=".4" stroke-dasharray="2 3"></path>
      {%- elif art == 2 %}<circle cx="28" cy="28" r="21" opacity=".4"></circle><circle cx="28" cy="28" r="9"></circle><circle cx="28" cy="28" r="2" fill="currentColor"></circle><path d="M28 7v12M28 37v12M7 28h12M37 28h12" opacity=".5"></path>
      {%- else %}<path d="M8 46c4-24 12-34 20-34s16 10 20 34" opacity=".45"></path><path d="M12 46c4-16 10-24 16-24s12 8 16 24"></path><path d="M28 6v10M24 12l4 4 4-4"></path>
      {%- endif %}
    </svg><span class="fig-tag">Image</span>
  </div>
  {% endif %}
  {% if theme.data.caption %}<figcaption>{{ theme.data.caption }}</figcaption>{% endif %}
</figure>
<div class="theme-detail">
  {{ theme.content | safe }}
  {% if theme.data.tags.length %}<div class="tags">{% for t in theme.data.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
</div>
