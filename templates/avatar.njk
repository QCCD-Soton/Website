{#- Headshot, or a coloured silhouette until there is one. Expects `person`. -#}
<div class="avatar{% if person.data.photo %} has-photo{% endif %}" style="--h:{{ person.data.name | hue }}">
  {%- if person.data.photo %}<img src="{{ person.data.photo | img }}" alt="{{ person.data.name }}" eleventy:widths="400,800" sizes="(min-width: 1040px) 300px, (min-width: 560px) 50vw, 100vw">{% else %}{{ person.data.name | initials }}{% endif -%}
</div>
